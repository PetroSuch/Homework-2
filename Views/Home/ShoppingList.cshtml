@model Dictionary<string, int>

@{
    ViewData["Title"] = "Shopping List";
}

<div class="text-center">
    <h1 class="display-4">Shopping List</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Quantity</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {   
                <tr>
                    <td>@item.Key</td>
                    <td>@item.Value</td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="TimeToBuy" />
</div>
