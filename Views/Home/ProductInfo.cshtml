@model List<Product>

@{
    ViewData["Title"] = "Product Info";
}

<div class="page-content mx-auto my-4">
    <h1 class="h3 mb-4">Product info</h1>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">Product</th>
                    <th scope="col" class="text-end">Price, UAH / unit</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td class="text-end">@item.Price.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
