@{
    ViewData["Title"] = "SuperMarkets";
}

<div class="page-content mx-auto my-4">
    <h1 class="h3 mb-4">Our supermarkets</h1>
    <p class="text-muted">Available supermarkets: @ViewBag.SuperMarkets.Count</p>

    <ul class="list-group">
        @foreach (var item in ViewBag.SuperMarkets)
        {
            <li class="list-group-item">@item</li>
        }
    </ul>
</div>
